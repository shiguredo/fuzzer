{minimum_otp_vsn, "29.1"}.

{erl_opts, [{i, "src"},
            warnings_as_errors,
            warn_export_all,
            warn_unused_import]}.

{src_dirs, ["src", "examples/rtp/src", "examples/sdp/src"]}.

{eunit_opts, [verbose]}.

{plugins, [rebar3_hex]}.

%% https://rebar3.org/docs/configuration/configuration/#xref
{xref_checks, [undefined_function_calls, undefined_functions,
               locals_not_used,
               deprecated_function_calls, deprecated_functions]}.

{xref_ignores,
 [{fuzzer, run, 5}]}.

{validate_app_modules, true}.

{compiler_error_format, rich}.
